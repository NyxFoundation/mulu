{
  "schema_version": 1,
  "use_case": "lottery",
  "source": "contracts/lottery/certora/*.spec",
  "note": "The benchmark ships one encoding per tool: `certora/` for Certora, `solcmc/` for solc's model checker. This is mulu's. Each property is the same rule as the file it names, written in the terms mulu's paths are written in.",
  "call_properties": [
    {
      "id": "enter-closes",
      "from": "certora/enter-closes.spec",
      "rules": [
        {
          "entrypoint": "enter()",
          "given": {
            "op": "ugt",
            "left": {
              "env": "number"
            },
            "right": {
              "add": {
                "left": {
                  "storage": "start"
                },
                "right": {
                  "storage": "duration"
                }
              }
            }
          },
          "assert": "reverts"
        }
      ]
    },
    {
      "id": "any-user-can-enter",
      "from": "certora/any-user-can-enter.spec",
      "rules": [
        {
          "entrypoint": "enter()",
          "given": {
            "op": "and",
            "args": [
              {
                "op": "eq",
                "left": {
                  "env": "callvalue"
                },
                "right": {
                  "uint256": "10000000000000000"
                }
              },
              {
                "op": "ule",
                "left": {
                  "storage": "start"
                },
                "right": {
                  "env": "number"
                }
              },
              {
                "op": "ule",
                "left": {
                  "env": "number"
                },
                "right": {
                  "add": {
                    "left": {
                      "storage": "start"
                    },
                    "right": {
                      "storage": "duration"
                    }
                  }
                }
              }
            ]
          },
          "assert": "does-not-revert"
        }
      ]
    }
  ]
}
