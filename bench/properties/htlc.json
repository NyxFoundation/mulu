{
  "schema_version": 1,
  "use_case": "htlc",
  "source": "contracts/htlc/certora/*.spec",
  "note": "The benchmark ships one encoding per tool: `certora/` for Certora, `solcmc/` for solc's model checker. This is mulu's. Each property is the same rule as the file it names, written in the terms mulu's paths are written in.",
  "call_properties": [
    {
      "id": "commit-auth-owner",
      "from": "certora/commit-auth-owner.spec",
      "rules": [
        {
          "entrypoint": "commit(bytes32)",
          "given": {
            "op": "ne",
            "left": {
              "env": "caller"
            },
            "right": {
              "storage": "owner"
            }
          },
          "assert": "reverts"
        }
      ]
    },
    {
      "id": "reveal-auth-owner",
      "from": "certora/reveal-auth-owner.spec",
      "rules": [
        {
          "entrypoint": "reveal(string)",
          "given": {
            "op": "ne",
            "left": {
              "env": "caller"
            },
            "right": {
              "storage": "owner"
            }
          },
          "assert": "reverts"
        }
      ]
    },
    {
      "id": "timeout-deadline",
      "from": "certora/timeout-deadline.spec",
      "rules": [
        {
          "entrypoint": "timeout()",
          "given": {
            "op": "ult",
            "left": {
              "env": "number"
            },
            "right": {
              "add": {
                "left": {
                  "storage": "start"
                },
                "right": {
                  "uint256": "1000"
                }
              }
            }
          },
          "assert": "reverts"
        }
      ]
    }
  ]
}
