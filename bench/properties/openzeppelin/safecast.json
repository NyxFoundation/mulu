      "id": "to-uint8-reverts",
      "from": "fv/specs/SafeCast, toUint8",
      "rules": [
        {
          "entrypoint": "toUint8(uint256)",
          "given": {
            "op": "ugt",
            "left": {
              "argument": 0
            },
            "right": {
              "uint256": "255"
            }
          },
          "assert": "reverts"
        }
      ]
    },
    {
