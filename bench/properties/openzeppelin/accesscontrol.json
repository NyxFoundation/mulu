{
  "schema_version": 1,
  "use_case": "openzeppelin-accesscontrol",
  "source": "openzeppelin-contracts fv/specs/AccessControl.spec, against a harness of the shape fv/harnesses uses",
  "note": "`_roles[role].members[account]` is two mapping accesses over one declared variable and `_roles[role].adminRole` is the second word of the first, which is why the terms nest. The post-state halves of OpenZeppelin's rules are about the state a call leaves rather than whether it is accepted, and are not written. Every rule here is expected to hold.",
  "call_properties": [
    {
      "id": "grant-only-admin-reverts",
      "from": "fv/specs/AccessControl.spec rule grantRoleEffect, the <= direction",
      "rules": [
        {
          "entrypoint": "grantRole(bytes32,address)",
          "given": {
            "op": "eq",
            "left": {
              "nested": {
                "var": "_roles",
                "keys": [
                  {
                    "field": {
                      "of": {
                        "cell": {
                          "var": "_roles",
                          "key": {
                            "argument": 0
                          }
                        }
                      },
                      "index": 1
                    }
                  },
                  {
                    "env": "caller"
                  }
                ]
              }
            },
            "right": {
              "uint256": "0"
            }
          },
          "assert": "reverts"
        }
      ]
    },
    {
