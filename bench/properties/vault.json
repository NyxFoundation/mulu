{
  "schema_version": 1,
  "use_case": "vault",
  "source": "contracts/vault/certora/*.spec",
  "note": "The benchmark ships one encoding per tool: `certora/` for Certora, `solcmc/` for solc's model checker. This is mulu's. Each property is the same rule as the file it names, written in the terms mulu's paths are written in.",
  "call_properties": [
    {
      "id": "canc-revert",
      "from": "certora/canc-revert.spec",
      "rules": [
        {
          "entrypoint": "cancel()",
          "given": {
            "op": "ne",
            "left": {
              "env": "caller"
            },
            "right": {
              "storage": "recovery"
            }
          },
          "assert": "reverts"
        }
      ]
    },
    {
      "id": "wd-fin-revert",
      "from": "certora/wd-fin-revert.spec",
      "rules": [
        {
          "entrypoint": "withdraw(address,uint256)",
          "given": {
            "op": "ne",
            "left": {
              "env": "caller"
            },
            "right": {
              "storage": "owner"
            }
          },
          "assert": "reverts"
        },
        {
          "entrypoint": "finalize()",
          "given": {
            "op": "ne",
            "left": {
              "env": "caller"
            },
            "right": {
              "storage": "owner"
            }
          },
          "assert": "reverts"
        }
      ]
    },
    {
      "id": "wd-fin-before",
      "from": "certora/wd-fin-before.spec",
      "rules": [
        {
          "entrypoint": "finalize()",
          "given": {
            "op": "ult",
            "left": {
              "env": "number"
            },
            "right": {
              "add": {
                "left": {
                  "storage": "request_time"
                },
                "right": {
                  "storage": "wait_time"
                }
              }
            }
          },
          "assert": "reverts"
        }
      ]
    }
  ]
}
